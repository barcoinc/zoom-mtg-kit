# Zoom Server-to-Server OAuth の認証情報
# Zoom Marketplace で自分のアカウント用に作成したアプリの値を入れる（SETUP.md 参照）
#
# 【重要】このファイルは絶対に他人に渡さないこと。
# 渡すと、その相手が自分のZoom録画すべてにアクセスできてしまう。

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 録画の持ち主のメールアドレス（Zoomにログインしているアドレス）
ZOOM_USER_EMAIL=

# 任意: ダウンロード先。未設定なら ~/Downloads/zoom-recordings
# ZOOM_DOWNLOAD_DIR=

# 任意: 録画をVimeoへ退避したい場合のみ
# developer.vimeo.com/apps で upload / edit / private / video_files スコープ付きのトークンを発行
# VIMEO_ACCESS_TOKEN=

# 案件フォルダの「親」のパス（絶対パスで書く）
#
# 【設定を強くすすめます】録画を消す前の安全装置が、ここの配下を再帰で探して
# 「この録画の文字起こしは保存済みか」を確かめます。
# 未設定だと一時置き場しか見ないので、**正しく案件フォルダへ整理した人ほど**
# 「文字起こしが無い」と誤判定されて削除が止まります。
#
# 例: ZOOM_ARCHIVE_ROOT=/home/自分の名前/仕事/clients
ZOOM_ARCHIVE_ROOT=
